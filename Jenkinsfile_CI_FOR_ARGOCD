pipeline {
    agent any

    environment {
        IMAGE_NAME = "ghcr.io/talashtests/cicd-k3s-demo"
        IMAGE_TAG  = "${env.BUILD_NUMBER}"
    }

    stages {

        stage('Branch Guard') {
            steps {
                script {
                    if (env.BRANCH_NAME != null && env.BRANCH_NAME != 'main') {
                        echo "This build was triggered by branch: ${env.BRANCH_NAME}"
                        echo "Only 'main' branch is allowed to run CI. Stopping."
                        currentBuild.result = 'NOT_BUILT'
                        error("Stopping pipeline — not main branch.")
                    } else {
                        echo "Branch check passed. Running CI for main branch."
                    }
                }
            }
        }

        stage('Checkout App Repo (main)') {
            steps {
                dir('main-repo') {
                    git credentialsId: 'github-creds',
                        url: 'https://github.com/talashtests/cicd-k3s-demo.git',
                        branch: 'main'
                }
            }
        }

        stage('Validate Python') {
            steps {
                dir('main-repo') {
                    sh 'python3 -m py_compile app.py'
                }
            }
        }

        stage('Build Image') {
            steps {
                dir('main-repo') {
                    sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Login to GHCR') {
            steps {
                withCredentials([string(credentialsId: 'github-personal-access-token-classic', variable: 'TOKEN')]) {
                    sh 'echo $TOKEN | docker login ghcr.io -u talashtests --password-stdin'
                }
            }
        }

        stage('Push Image') {
            steps {
                sh "docker push ${IMAGE_NAME}:${IMAGE_TAG}"
            }
        }

        stage('Prepare Updated Manifest') {
            steps {
                dir('main-repo') {
                    sh """
                        sed -i 's|image: ghcr.io/talashtests/cicd-k3s-demo:.*|image: ${IMAGE_NAME}:${IMAGE_TAG}|' deployment.yaml
                    """
                }
            }
        }

        stage('Checkout Deploy Branch') {
            steps {
                dir('deploy-repo') {
                    git credentialsId: 'github-creds',
                        url: 'https://github.com/talashtests/cicd-k3s-demo.git',
                        branch: 'deploy'
                }
            }
        }

        stage('Update Deploy Branch & Push') {
            steps {
                withCredentials([string(credentialsId: 'github-personal-access-token-classic', variable: 'TOKEN')]) {
                    sh """
                        cp main-repo/deployment.yaml deploy-repo/deployment.yaml

                        cd deploy-repo
                        git config user.email "jenkins@local"
                        git config user.name "jenkins"

                        git add deployment.yaml
                        git commit -m "Update image to ${IMAGE_TAG} [skip ci]" || echo "No changes to commit"

                        git push https://talashtests:${TOKEN}@github.com/talashtests/cicd-k3s-demo.git deploy
                    """
                }
            }
        }
    }
}
